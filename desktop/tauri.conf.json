{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mma-shell",
  "version": "0.1.0",
  "identifier": "top.leoblack.mma-shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ManiaMapAnalyser",
        "width": 440,
        "height": 680,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false,
        "visible": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}