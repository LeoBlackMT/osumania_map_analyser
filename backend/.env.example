# osumania-telemetry configuration — copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets.

# HTTP listen address. Bind to loopback when running behind a reverse proxy.
MMA_TELEMETRY_ADDR=:8080

# SQLite database path.
MMA_TELEMETRY_DB=telemetry.db

# Raw event retention in days. Raw events are only a debug log — every
# dashboard statistic comes from the permanent aggregates, so this value does
# not change any metric. 0 = keep raw events forever.
MMA_TELEMETRY_RAW_RETENTION_DAYS=14

# "Active" definition: an install counts as active on a UTC day only if it
# sent at least this many analyze events that day.
MMA_TELEMETRY_ACTIVE_MIN=10

# Rolling window (days) for the per-install hourly presence table
# (feeds the 24h-of-day distribution and hourly trend; 90 = dashboard max).
MMA_TELEMETRY_HOUR_RETENTION_DAYS=90

# "Online" window in minutes (an install whose last_seen is within this is online).
MMA_TELEMETRY_ONLINE_WINDOW_MIN=10

# Ingest rate limit: requests per minute per IP (0 disables).
MMA_TELEMETRY_RATE_LIMIT_PER_MIN=120

# /api/v1/stats aggregate cache, seconds.
MMA_TELEMETRY_STATS_CACHE_SECONDS=60

# --- Huawei Cloud OBS backup (all four required to enable; empty = disabled) ---
MMA_BACKUP_OBS_AK=
MMA_BACKUP_OBS_SK=
MMA_BACKUP_OBS_ENDPOINT=
MMA_BACKUP_OBS_BUCKET=
MMA_BACKUP_DAILY_KEEP=30
MMA_BACKUP_MONTHLY_KEEP=12

# --- RC difficulty feedback (separate database; disabled by default) ---
# The route stays 404 unless FEEDBACK_ENABLED=true and every required key below
# is present. Nothing is deployed from this repository by default.
FEEDBACK_ENABLED=false

# Separate SQLite file; kept out of telemetry.db on purpose.
MMA_FEEDBACK_DB=feedback.db

# Require an osu! API identity check (bid exists, mania, not convert, checksum
# matches). Keep true in production. Set false only for local development.
FEEDBACK_OSU_VALIDATION=true
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# osu! allows 60 requests/minute. 50 leaves headroom; burst 1 means ~1 req/s.
FEEDBACK_OSU_RATE_PER_MIN=50
FEEDBACK_OSU_RATE_BURST=1
# A request that cannot obtain a token in this window is rejected, never queued.
FEEDBACK_OSU_WAIT_MS=2000
FEEDBACK_NEGATIVE_CACHE_DAYS=7
FEEDBACK_API_COOLDOWN_SECONDS=60

# Ed25519 public keys the shell signs with: `keyid:hex,keyid2:hex`.
# Generate a pair with `go run ./cmd/feedback-keygen`.
FEEDBACK_PUBLIC_KEYS=
# Reject the development key (key_id=dev). Keep false only in local tests.
FEEDBACK_ALLOW_DEV_KEY=false

# HMAC secret used to turn install ids into per-map dedup tokens (32+ bytes).
FEEDBACK_DEDUP_SECRET=
FEEDBACK_DEDUP_DAYS=30
FEEDBACK_RAW_RETENTION_DAYS=180

# Per-IP and per-map limits (fixed window, in memory only).
FEEDBACK_RATE_LIMIT_PER_HOUR=5
FEEDBACK_MAP_DAILY_CAP=20

# Aggregation: minimum accepted votes before a map row is published, and the
# fraction trimmed from each tail before the weighted median.
FEEDBACK_MIN_N=8
FEEDBACK_TRIM_RATIO=0.10

# Private admin page (/feedback) and its JSON/CSV endpoints.
FEEDBACK_ADMIN_TOKEN=